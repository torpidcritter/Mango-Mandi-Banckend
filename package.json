{
  "name": "mango-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p customer-app",
    "test:e2e": "playwright test",
    "shop:dev": "vite --config customer-app/vite.config.ts",
    "shop:build": "tsc --noEmit -p customer-app && vite build --config customer-app/vite.config.ts",
    "shop:preview": "vite preview --config customer-app/vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
