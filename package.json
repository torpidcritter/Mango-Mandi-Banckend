{
  "name": "mango-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p customer-app && tsc --noEmit -p customer-app/tests",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/unit/*.unit.ts\" \"customer-app/tests/unit/*.unit.ts\"",
    "lint": "eslint .",
    "scan:bundle": "node scripts/scan-bundle.mjs dist customer-app/dist",
    "shop:dev": "vite --config customer-app/vite.config.ts",
    "shop:build": "tsc --noEmit -p customer-app && vite build --config customer-app/vite.config.ts",
    "shop:preview": "vite preview --config customer-app/vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "@vercel/blob": "^2.8.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.5.3",
    "vite": "^6.4.5"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
