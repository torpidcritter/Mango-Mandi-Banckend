{
  "name": "mango-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "preflight": "node --env-file-if-exists=.env src/preflight-cli.js",
    "smoke": "node scripts/smoke.mjs",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "vercel-build": "node src/migrate.js && node src/seed.js"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  }
}
