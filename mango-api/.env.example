# Copy to .env (or set in your host) and fill in. Production refuses to start with the dev defaults.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://mango:mango@localhost:5432/mango
# 32+ random characters in production: openssl rand -hex 32
JWT_SECRET=
# The admin panel's origin(s), comma-separated. Needed for the refresh cookie and CORS.
ADMIN_ORIGIN=http://localhost:5173
# The customer app's address (comma-separate several)
CUSTOMER_ORIGIN=http://localhost:5174
# false only for plain-http local development
COOKIE_SECURE=true
# Number of proxies in front of the API (for rate limits by client IP)
TRUST_PROXY=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only while rotating the webhook secret: the old one, for a day.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Optional bearer token for GET /metrics
METRICS_TOKEN=
# OTP delivery: log (development) or jio (required in production)
SMS_PROVIDER=log
# With SMS_PROVIDER=log, also write the codes to the log (a preview, say). Development gets them as devCode.
LOG_OTP_CODES=false
# Outside production the login code also comes back in the response (devCode). false keeps it
# out (scripts/start-local.mjs --phone does this, with LOG_OTP_CODES=true).
OTP_CODE_IN_RESPONSE=true
# Pepper for stored login-code hashes; unset uses JWT_SECRET. Codes already sent keep working.
OTP_PEPPER=
# Months after delivery that an order keeps the customer's name, phone and address (default 12).
PII_RETENTION_MONTHS=12
# Staff Google sign-in only for this Google Workspace domain (unset: any verified staff email).
STAFF_GOOGLE_HD=
# Local development only: /v1/dev routes that mark orders paid (the shop's test-mode pay buttons, e2e tests).
# Ignored in production and whenever Razorpay keys are set.
ENABLE_DEV_ROUTES=true
JIO_SMS_URL=
JIO_SMS_API_KEY=
# DLT registration: 6-character header, template ID and principal entity ID
JIO_SMS_SENDER_ID=
JIO_SMS_TEMPLATE_ID=
JIO_SMS_ENTITY_ID=
# Must match the DLT template exactly; {code} is replaced with the login code
JIO_SMS_TEXT={code} is your MandiMangoes login code. It expires in 5 minutes.
# How Jio's reply says the SMS was accepted, copied from Jio's API documentation
# (a dot path into the JSON reply, and the accepted values, comma separated).
# Required with SMS_PROVIDER=jio: an HTTP 200 alone does not count as sent.
JIO_SMS_SUCCESS_PATH=
JIO_SMS_SUCCESS_VALUES=
JIO_SMS_ID_PATH=
# sms or whatsapp: the first channel tried for login codes. Use whatsapp until Jio DLT is approved.
OTP_DEFAULT_CHANNEL=sms
# WhatsApp order updates: log (development) or meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Approved templates are named prefix + kind, e.g. mandi_order_confirmed (see README)
WHATSAPP_TEMPLATE_PREFIX=mandi_
WHATSAPP_LANGUAGE=en
# Ordering in the chat: the webhook verify token you choose in the Meta app, and the app secret
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: pay inside WhatsApp (Razorpay payment configuration name). Unset sends a Razorpay link.
# Keep it unset for now: there is no reconcile for WhatsApp payments yet (preflight warns).
WHATSAPP_PAYMENT_CONFIG=
# Turn each on only after Meta approves the templates (mango-api/README.md, WhatsApp order updates):
# claim received / claim rejected messages, and the "Open order" button on the order update templates.
WHATSAPP_CLAIM_UPDATES=false
WHATSAPP_ORDER_LINKS=false
# Demo batches on an empty database (never in production)
SEED_DEMO_DATA=true
# Production only: creates the first manager when there are no staff accounts
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
